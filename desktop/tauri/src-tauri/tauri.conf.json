{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Toastmasters Tools",
  "version": "0.45.0",
  "identifier": "org.ramnaths89.toastmasters-tools",
  "build": {
    "frontendDist": "../../.."
  },
  "app": {
    "windows": [
      {
        "title": "Toastmasters Tools",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/256x256.png",
      "icons/512x512.png"
    ]
  }
}
